{% extends 'base.html.twig' %}

{% block title %}Orders List{% endblock %}

{% block body %}
    <h1>Orders List</h1>

    {% if orders|length > 0 %}
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for order in orders %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>{{ order.user.username }}</td>
                        <td>{{ order.pname }}</td>
                        <td>{{ order.price }} DH</td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-secondary dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown">
                                    {{ order.status }}
                                </button>

                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           href="{{ path('order_status_update', {id: order.id, status: 'Shipped'}) }}">
                                            Shipped
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           href="{{ path('order_status_update', {id: order.id, status: 'Rejected'}) }}">
                                            Rejected
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                        <td>
                            <a href="{{ path('order_delete', {id: order.id}) }}"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Are you sure?')">
                                Delete
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>No orders found.</p>
    {% endif %}
{% endblock %}