{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}

<div class="row my-5">
    <div class="col-md-6">
        {% if product.image %}
            <img src="{{ asset('uploads/' ~ product.image) }}" alt="{{ product.name }}" class="img-fluid rounded">
        {% endif %}
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h3>{{ product.name }}</h3>
                <p>{{ product.description }}</p>

                <h4 class="text-danger">{{ product.price }}DH</h4>
                <p class="text-success fw-bold">{{ product.category.name }}</p>

                <a href="#" class="btn btn-primary">Order now</a>
            </div>
        </div>
    </div>
</div>

{% endblock %}