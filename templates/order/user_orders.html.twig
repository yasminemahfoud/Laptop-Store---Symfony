{% extends 'base.html.twig' %}

{% block title %}My Orders{% endblock %}

{% block body %}
    <h1>My Orders</h1>

    {% if orders|length > 0 %}
        {% set sum = 0 %}
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for order in orders %}
                    {% set sum = sum + order.price %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>{{ order.pname }}</td>
                        <td>{{ order.price }} DH</td>
                        <td>
                            {% if order.status == 'processing...' %}
                                <span class="badge bg-dark p-2">{{ order.status }}</span>
                            {% elseif order.status == 'shipped' %}
                                <span class="badge bg-danger p-2">{{ order.status }}</span>
                            {% elseif order.status == 'delivered' %}
                                <span class="badge bg-success p-2">{{ order.status }}</span>
                            {% else %}
                                <span class="badge bg-secondary p-2">{{ order.status }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                <tr class="text-center">
                    <th colspan="3">Total</th>
                    <td class="fw-bold">{{ sum }} DH</td>
                </tr>
            </tbody>
        </table>
    {% else %}
        <div class="text-center mt-5">
            <h3 class="text-secondary">No Orders Yet</h3>
            <p class="text-muted">
                You haven't placed any orders yet. Start shopping to see your orders here.
            </p>

            <a href="{{ path('app_product') }}" class="btn btn-primary mt-3">
                Browse Products
            </a>
        </div>
    {% endif %}
{% endblock %}