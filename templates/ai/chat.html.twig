{% extends 'base.html.twig' %}

{% block title %}AI Laptop Assistant{% endblock %}

{% block body %}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-dark text-white">

            <h3>🤖 AI Laptop Assistant</h3>

            <small>
                Ask me anything about the laptops available in our store.
            </small>

        </div>

        <div class="card-body">

            <div id="chatBox"
                 style="
                    height:450px;
                    overflow-y:auto;
                    border:1px solid #ddd;
                    padding:15px;
                    background:#f8f9fa;
                    border-radius:10px;
                 ">

                <div class="mb-3">

                    <strong class="text-primary">
                        AI :
                    </strong>

                    Hello 👋<br>

                    I'm your Laptop Store assistant.

                    Ask me anything about laptops.

                </div>

            </div>

            <div class="mt-3">

                <textarea
                        id="message"
                        class="form-control"
                        rows="3"
                        placeholder="Example: I need a laptop under 9000 DH for programming">
                </textarea>

            </div>

            <div class="mt-3 text-end">

                <button
                        id="sendBtn"
                        class="btn btn-dark">

                    Send

                </button>

            </div>

        </div>

    </div>

</div>

<script>

const chatBox = document.getElementById("chatBox");
const button = document.getElementById("sendBtn");
const textarea = document.getElementById("message");

button.onclick = function(){

    let message = textarea.value.trim();

    if(message===""){
        return;
    }

    chatBox.innerHTML += `
        <div class="mb-3 text-end">
            <strong>You :</strong><br>
            ${message}
        </div>
    `;

    textarea.value="";

    chatBox.innerHTML += `
        <div id="loading">
            <strong class="text-primary">
                AI :
            </strong>

            typing...
        </div>
    `;

    chatBox.scrollTop = chatBox.scrollHeight;

    fetch("/ai/chat",{

        method:"POST",

        headers:{
            "Content-Type":"application/x-www-form-urlencoded"
        },

        body:new URLSearchParams({
            message:message
        })

    })

    .then(response=>response.json())

    .then(data=>{

        document.getElementById("loading").remove();

        chatBox.innerHTML += `
            <div class="mb-3">
                <strong class="text-primary">
                    AI :
                </strong><br>

                ${data.reply.replace(/\n/g,"<br>")}
            </div>
        `;

        chatBox.scrollTop = chatBox.scrollHeight;

    });

}

</script>

{% endblock %}