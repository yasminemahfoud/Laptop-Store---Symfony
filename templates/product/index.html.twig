{% extends 'base.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-12 d-flex justify-content-between align-items-center mb-4">
        <h2>
            Products
            <span class="badge bg-danger rounded-circle">{{ products|length }}</span>
        </h2>

        <div class="btn-group">
            <a href="{{ path('app_product') }}" class="btn btn-outline-dark">All</a>
            {% for category in categories %}
                <a href="{{ path('app_product_filter', { id: category.id }) }}" class="btn btn-outline-dark">
                    {{ category.name }}
                </a>
            {% endfor %}
        </div>
    </div>

    {% for product in products %}
        <div class="col-md-3 mb-4">
            <div class="card h-100">
                {% if product.image %}
                    <img src="{{ asset('uploads/' ~ product.image) }}" class="card-img-top" alt="{{ product.name }}">
                {% else %}
                    <img src="{{ asset('uploads/default.png') }}" class="card-img-top" alt="No image">
                {% endif %}

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">{{ product.name }}</h5>
                    <p class="card-text">{{ product.description }}</p>
                    <p class="text-danger fw-bold">{{ product.price }}DH</p>

                    <a href="{{ path('app_product_show', { id: product.id }) }}" class="btn btn-primary mt-auto">
                        View
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <p>No products found.</p>
    {% endfor %}
</div>
{% endblock %}