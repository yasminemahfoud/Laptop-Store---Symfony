{% extends 'base.html.twig' %}

{% block title %}Product Liste{% endblock %}

{% block body %}

<div class="row my-5">
    <div class="col-md-10 mx-auto">

        {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
        {% endfor %}

        <div class="mb-3">
            <a href="{{ path('app_product') }}" class="btn btn-sm btn-outline-secondary">All</a>
            {% for category in categories %}
            <a href="{{ path('app_product_filter', {id: category.id}) }}" class="btn btn-sm btn-outline-dark">{{ category.name }}</a>
            {% endfor %}
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>List of products</span>
                <a href="{{ path('app_product_create') }}" class="btn btn-primary btn-sm">Add</a>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Image</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in products %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>{{ product.name }}</td>
                            <td>{{ product.category.name }}</td>
                            <td>{{ product.quantity }}</td>
                            <td>{{ product.price }}</td>
                            <td>
                                {% if product.image %}
                                <img src="{{ absolute_url('uploads/' ~ product.image) }}"
                                     width="60" height="60"
                                     alt="{{ product.name }}"
                                     class="img-fluid my-2 rounded">
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('app_product_show', {id: product.id}) }}" class="btn btn-sm btn-dark">Show</a>
                                <a href="{{ path('app_product_edit', {id: product.id}) }}" class="btn btn-sm btn-warning">Edit</a>
                                <a href="{{ path('app_product_delete', {id: product.id}) }}" class="btn btn-sm btn-danger delete-btn">Delete</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.querySelectorAll('.delete-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
        e.preventDefault();
        const url = this.getAttribute('href');
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = url;
            }
        });
    });
});
</script>

{% endblock %}