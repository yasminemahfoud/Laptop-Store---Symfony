{% extends 'base.html.twig' %}

{% block title %}My order {% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-12 d-flex justify-content-between align-items-center mb-4">
        <h2>
            My orders
            <span class="badge bg-danger rounded-circle">{{ products|length }}</span>
        </h2>

        <div class="btn-group">
            <a href="{{ path('app_product') }}" class="btn btn-outline-dark">All</a>
            {% for category in categories %}
                <a href="{{ path('app_product_filter', { id: category.id }) }}" class="btn btn-outline-dark">
                    {{ category.name }}
                </a>
            {% endfor %}
            <div class="card-header">
            <table class="table table-bordered   table-hover">
            <thead>
            <tr>
            <th>ID</th>
            <th>Products Name</th>
            <th>Status</th>
            </tr>

        </div>
    </div>
    {%set sum=0%}
    {% for oder in user.orders %}
    {%set sum =sum + order.price %}
    <tr>
    <td>{{loop.index}}</td>
    <td>{{order.name}}</td>
    <td>{{Product.Price}}</td>
    <td>
    {%if order.status =='processing...'%}
    <span class="badge bg-dark p-2">
     {{order.status }}
     </span>
    {% elseif order.status=='shipped' %}
    <span class="badge bg-danger p-2">
     {{order.status }}
     </span>
    {% else  %} 
    {% endif %}

</td>
</tr>
 {% endfor %} 
 <tr class="text-center">
    <th colspan="3">total</th>
    <td class="fw-bold">{{sum}}DH </td>
 </tr>                 
                </div>
            </div>
        </div>
  
</div>
{% endblock %}