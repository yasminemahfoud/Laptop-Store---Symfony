{% extends 'base.html.twig' %}

{% block title %}My order {% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-12 d-flex justify-content-between align-items-center mb-4">
        <h2>
            My orders
            <span class="badge bg-danger rounded-circle">{{ products|length }}</span>
        </h2>

        <div class="btn-group">
            <a href="{{ path('app_product') }}" class="btn btn-outline-dark">All</a>
            {% for category in categories %}
                <a href="{{ path('app_product_filter', { id: category.id }) }}" class="btn btn-outline-dark">
                    {{ category.name }}
                </a>
            {% endfor %}
            <div class="card-header">
            <table class="table table-bordered   table-hover">
            <thead>
            <tr>
            <th>ID</th>
            <th>Products Name</th>
            <th>Status</th>
            </tr>

        </div>
    </div>

    {% for oder in user.orders %}
    <tr>
    <td>{{loop.index}}</td>
    <td>{{order.name}}</td>
    <td>{{Product.Price}}</td>

</tr>
 {% endfor %}                  
                </div>
            </div>
        </div>
  
</div>
{% endblock %}