{% extends 'base.html.twig' %}

{% block title %}Edit {{ product.name }}{% endblock %}

{% block body %}

<div class="row my-5">
    <div class="col-md-6 mx-auto">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Edit {{ product.name }}</span>
                <a href="{{ path('app_product') }}" class="btn btn-sm btn-secondary">Back</a>
            </div>
            <div class="card-body">
                {{ form(form) }}
            </div>
        </div>
    </div>
</div>

{% endblock %}