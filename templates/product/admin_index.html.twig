{% extends 'base.html.twig' %}

{% block title %}List of products{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>List of products</span>
            <a href="{{ path('app_product_create') }}" class="btn btn-primary">Add</a>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Image</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                    <tr>
                        <td>{{ product.id }}</td>
                        <td>{{ product.name }}</td>
                        <td>{{ product.category }}</td>
                        <td>{{ product.quantity }}</td>
                        <td>{{ product.price }}</td>
                        <td>
                            {% if product.image %}
                            <img src="/uploads/{{ product.image }}" width="60">
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_product_show', {id: product.id}) }}" class="btn btn-dark btn-sm">show</a>
                            <a href="{{ path('app_product_edit', {id: product.id}) }}" class="btn btn-warning btn-sm">edit</a>
                            <a href="{{ path('app_product_delete', {id: product.id}) }}" class="btn btn-danger btn-sm">delete</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}